//patched on 2026-10-27
{
    "files.autoSave": "afterDelay",
    "editor.fontFamily": "JetBrains Mono",
    "editor.fontLigatures": true,
    "redhat.telemetry.enabled": false,
    "terminal.integrated.fontFamily": "'MesloLGS NF'",
    "cSpell.userWords": [
      "argparser",
      "excp",
      "indx",
      "logme",
      "mcli"
    ],
    "cSpell.language": "en,ru",
    "terminal.integrated.defaultProfile.osx": "zsh",
    "terminal.external.osxExec": "iTerm.app",
    "terminal.explorerKind": "external",
    "terminal.integrated.macOptionIsMeta": true,
    "security.workspace.trust.untrustedFiles": "open",
    "numberedBookmarks.keepBookmarksOnLineDelete": true,
    "numberedBookmarks.navigateThroughAllFiles": "replace",
    "oneDarkPro.vivid": false,
    "workbench.colorTheme": "Monokai Pro",
    "linter.linters": {
        "hadolint": {
          "capabilities": [
            "ignore-line"
          ],
          "command": [
            "hadolint",
            "--format",
            "json",
            [
              "$config",
              "--config",
              "$config"
            ],
            "-"
          ],
          "configFiles": [
            ".hadolint.yml",
            ".hadolint.yaml"
          ],
          "enabled": true,
          "languages": [
            "dockerfile"
          ],
          "name": "hadolint",
          "url": "https://github.com/hadolint/hadolint"
        },
        "pylint": {
          "capabilities": [
            "ignore-file"
          ],
          "command": [
            "pylint",
            "--from-stdin",
            "--output-format",
            "json",
            [
              "$config",
              "--rcfile",
              "$config"
            ],
            "$file"
          ],
          "configFiles": [
            ".pylintrc"
          ],
          "enabled": true,
          "languages": [
            "python"
          ],
          "name": "pylint",
          "url": "https://www.pylint.org"
        },
        "yamllint": {
          "capabilities": [
            "ignore-line"
          ],
          "command": [
            "yamllint",
            "--format",
            "parsable",
            [
              "$config",
              "--config-file",
              "$config"
            ],
            "-"
          ],
          "configFiles": [
            ".yamllint.yml",
            ".yamllint.yaml",
            ".yamllint"
          ],
          "enabled": true,
          "languages": [
            "yaml"
          ],
          "name": "yamllint",
          "url": "https://github.com/adrienverge/yamllint"
        }
      },
      "terminal.integrated.allowChords": false,
      "terminal.integrated.copyOnSelection": true,
      "pylint.args": ["--max-line-length=180"],
      "flake8.args": [
        "--max-line-length=180",
        "--ignore=E722"
      ],
      "ansible.lightspeed.enabled": false,
      "ansible.lightspeed.suggestions.enabled": false,
      "window.openFoldersInNewWindow": "on",
      "git.openRepositoryInParentFolders": "never",
      "yaml.maxItemsComputed": 50000,
      "python.analysis.typeCheckingMode": "standard",
      "docker.extension.enableComposeLanguageServer": false,
      "cSpell.blockCheckingWhenAverageChunkSizeGreaterThan": 2000,
      "editor.unicodeHighlight.allowedLocales": {
        "ru": true
      },
      "[dockercompose]": {
        "editor.insertSpaces": true,
        "editor.tabSize": 2,
        "editor.autoIndent": "advanced",
        "editor.quickSuggestions": {
          "other": true,
          "comments": false,
          "strings": true
        },
        "editor.defaultFormatter": "redhat.vscode-yaml"
      },
      "[github-actions-workflow]": {
        "editor.defaultFormatter": "redhat.vscode-yaml"
      },
      "cSpell.blockCheckingWhenTextChunkSizeGreaterThan": 2000,
      "cSpell.enabledNotifications": {
        "Lines too Long": false,
        "Maximum Word Length Exceeded": false,
        "Average Word Length too Long": false
      },
      "terminal.integrated.enableMultiLinePasteWarning": "never",
      "workbench.iconTheme": "Monokai Pro Icons",
      "ansible.python.activationScript": "~/projects/ansible/.venv/bin/activate",
      "diffEditor.ignoreTrimWhitespace": false,
      "files.associations": {
        "*.haml": "ruby"
      },
      "git.blame.editorDecoration.enabled": true,
      "black-formatter.args": [
        "--line-length",
        "120"
      ],
    "[python]": {
      "editor.defaultFormatter": "ms-python.black-formatter"
    },
  "http.proxyStrictSSL": false,
  "workbench.editor.enablePreview": false,
  "python.venvPath": ".",
  "python.venvFolders": [
    ".venv"
  ],
  "editor.fontSize": 11,
  "chat.disableAIFeatures": true,
  "docker.extension.dockerEngineAvailabilityPrompt": false,
  "editor.gotoLocation.alternativeDefinitionCommand": "editor.action.revealDeclaration",
  "[shellscript]": {
    "editor.defaultFormatter": "mkhl.shfmt"
  }
}
